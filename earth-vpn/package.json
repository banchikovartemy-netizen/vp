{
  "name": "earth-vpn",
  "version": "1.1.0",
  "description": "Earth VPN for Ubuntu",
  "author": "Earth VPN",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --dir --linux --publish never && node scripts/package-deb.cjs",
    "start": "electron .",
    "test": "node --test tests/*.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "yaml": "^2.8.0",
    "i18n-iso-countries": "^7.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.earthvpn.desktop",
    "productName": "Earth VPN",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "linux": {
      "target": "deb",
      "category": "Network",
      "executableName": "earth-vpn",
      "maintainer": "Earth VPN"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2",
        "libgbm1",
        "libxss1",
        "libxtst6",
        "polkitd",
        "pkexec",
        "nodejs"
      ],
      "compression": "gz"
    },
    "directories": {
      "output": "release"
    },
    "publish": [],
    "afterPack": "./scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  },
  "homepage": "https://sing-box.sagernet.org/"
}